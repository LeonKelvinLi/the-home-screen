node_modules
dist
.env
*.db
*.db-journal
# WAL and shm carry live row data — including vendor bearer tokens — so the
# bare *.db rule was not enough. Both were tracked until this was caught.
*.db-wal
*.db-shm
.DS_Store

# tsc -b incremental state. A build artefact that changes on every build, so
# tracking it meant `git status` was never clean after a typecheck and the diff
# carried a blob nobody reads.
*.tsbuildinfo

# Python bytecode from the tools/ scripts
__pycache__/

# Throwaway verification scripts (need the repo node_modules to resolve)
.verify/

# Scratch scripts written straight into the repo root, and the folder a script
# creates when its output path comes out undefined. Both have been committed by
# accident before; neither belongs to this project.
/_*.mjs
/undefined/

# tools/stripe-setup.mjs writes the four billing values here, and one of them is
# the webhook signing secret. Ignored BEFORE the script that writes them was
# committed, so there is no window in which a run could stage a live key.
.stripe-live.env
.stripe-test.env

# The menu crawl: 575MB of page text, JSON and PDFs, re-creatable with tools/menu-scrape.ts.
# The reviewed candidates (research/menus/cand) and what was accepted stay in.
research/menus/raw/
