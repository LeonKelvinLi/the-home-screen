# Nothing loads this file on its own — export the values before `npm run dev`
# or `npm start` (`set -a; . .env; set +a`). Copy it to .env, which is
# gitignored, and fill in what you need. Production values live in the Render
# service's Environment tab; `bash tools/set-render-env.sh` changes them.

# --- Required ---------------------------------------------------------------
# Every table lives in Postgres; the server refuses to boot without this.
#   local:      the container from README "Run it"
#   production: the Render Postgres "beasty-db"
DATABASE_URL=postgres://beasty:beasty@localhost:55432/beasty
PORT=8787

# --- Money, see docs/STRIPE.md ----------------------------------------------
# Orders are MOCK: nothing is charged, and PAYMENTS_WIRED in server/index.ts is
# what decides, so a key alone cannot turn payments on. In production the
# server refuses to boot on mock payments unless ALLOW_MOCK_PAYMENTS=1 says you
# know.
ALLOW_MOCK_PAYMENTS=1
PLATFORM_FEE_BPS=1000
STRIPE_SECRET_KEY=
# Memberships go through Payment Links, one per tier; the webhook route is only
# registered when the signing secret is set. All three stay unset live until
# the Stripe account is activated.
STRIPE_PAYMENT_LINK_PASS=
STRIPE_PAYMENT_LINK_DIAMOND=
# The yearly links exist only once a tier in src/data/membership.ts carries a
# `yearly` price; tools/stripe-setup.mjs makes them at the same time.
STRIPE_PAYMENT_LINK_PASS_YEARLY=
STRIPE_PAYMENT_LINK_DIAMOND_YEARLY=
STRIPE_WEBHOOK_SECRET=

# --- The member pass (the QR on the member card) ----------------------------
# The card shows a token signed with this secret that changes every minute, so
# a screenshot cannot be redeemed by somebody else. Any long random string;
# unset, the server makes one per boot and every pass dies on restart.
PASS_SECRET=
# How often the pass rotates, in milliseconds. 60000 live; the audit sets it
# short to prove rotation without waiting.
PASS_WINDOW_MS=60000

# --- Sign-in codes and lead email, through Resend ---------------------------
# OTP_FROM_EMAIL must be on a domain verified in Resend. A resend.dev sender
# delivers only to the account owner — every other customer is told to check
# an email that never arrives. Unset, codes are printed to the log in
# development and delivered nowhere.
RESEND_API_KEY=
OTP_FROM_EMAIL=BEASTY <hello@beastypages.com>
# Where vendor leads (Reserve a Spot) and Designs enquiries are emailed.
# Comma-separated; unset means the lead only reaches the log.
LEAD_EMAIL=
DESIGNS_LEAD_EMAIL=
# Optional: also POST each vendor lead to a Slack or Discord incoming webhook.
LEAD_WEBHOOK_URL=

# --- SMS sign-in, off by decision until there are more users -----------------
# tools/setup-sms-login.sh fills these in. With a Verify service no A2P
# registration is needed; with a plain number, A2P_10DLC_REGISTERED=1 says the
# campaign cleared, otherwise US carriers drop the texts silently.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=
A2P_10DLC_REGISTERED=

# --- Operations ---------------------------------------------------------------
# Unlocks GET /api/applications and calendar writes. Unset, those routes 503.
OPERATOR_TOKEN=
# Walks tickets queued → cooking → ready → collected on a timer, for demos.
# Live it is 1; set it to 0 the moment a real kitchen display exists.
SIMULATE_KITCHEN=0

# --- Client, baked in at build time by Vite -----------------------------------
# VITE_ORDERING=live sends orders to the server; anything else keeps them in
# the browser. VITE_PAYMENTS is deliberately absent everywhere until payments
# are wired. VITE_API_BASE points the client at another origin; blank means
# same-origin.
VITE_ORDERING=live
VITE_API_BASE=
