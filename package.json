{
  "name": "fb-work",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "icons": "npm run build && node tools/icons.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "nanoid": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.5.0",
    "tsx": "^4.19.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
